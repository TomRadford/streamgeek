{
  "name": "streamgeek",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "dev:init": "rw-scripts dev-init",
    "preview": "vite preview",
    "worker:run": "rw-scripts worker-run",
    "clean": "pnpm run clean:vite",
    "clean:vite": "rm -rf ./node_modules/.vite",
    "release": "rw-scripts ensure-deploy-env && pnpm run clean && prisma generate && RWSDK_DEPLOY=1 pnpm run build && wrangler deploy",
    "migrate": "prisma migrate dev",
    "migrate:dev": "prisma generate && wrangler d1 migrations apply DB --local",
    "migrate:prd": "wrangler d1 migrations apply DB --remote",
    "migrate:new": "rw-scripts migrate-new",
    "seed": "pnpm run worker:run ./src/scripts/seed.ts",
    "generate": "prisma generate",
    "generate:app": "rw-scripts ensure-env && pnpm run generate && wrangler types --env-file .env.example",
    "check": "pnpm run generate && pnpm run types",
    "types": "tsc",
    "agent:dev": "tsx watch --env-file=./src/agent/.env ./src/agent/index.ts",
    "agent:dev:docker:up": "docker compose -f docker-compose-agent.yml up -d",
    "agent:dev:docker:down": "docker compose -f docker-compose-agent.yml down",
    "minio:up": "docker compose -f docker-compose-minio.yml up -d",
    "minio:down": "docker compose -f docker-compose-minio.yml down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/lib-storage": "^3.1053.0",
    "@hono/node-server": "^1.19.13",
    "@hono/zod-validator": "^0.7.2",
    "@prisma/adapter-d1": "~7.8.0",
    "@prisma/client": "~7.8.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tus/file-store": "^2.1.0",
    "@tus/server": "^2.4.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@uppy/core": "^4.5.2",
    "@uppy/drag-drop": "^4.2.2",
    "@uppy/file-input": "^4.2.2",
    "@uppy/progress-bar": "^4.3.2",
    "@uppy/react": "^4.5.1",
    "@uppy/tus": "^4.3.1",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "execa": "^9.6.1",
    "hls-video-element": "^1.5.11",
    "hono": "^4.12.22",
    "jsonwebtoken": "^9.0.3",
    "ky": "^2.0.2",
    "lucide-react": "^1.16.0",
    "media-chrome": "^4.19.0",
    "nanoid": "^5.1.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-server-dom-webpack": "^19.2.6",
    "rwsdk": "1.2.9",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.38.0",
    "@cloudflare/workers-types": "^4.20260524.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "prisma": "~7.8.0",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
